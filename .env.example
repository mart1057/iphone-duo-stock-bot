# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
TZ=Asia/Bangkok

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iphone_duo_stock_bot?schema=public

# ---------------------------------------------------------------------------
# LINE Messaging API (NOT LINE Notify)
#   LINE_CHANNEL_ACCESS_TOKEN : Messaging API channel -> long-lived access token
#   LINE_USER_ID              : target userId / groupId / roomId (comma separated
#                               for multiple recipients)
# ---------------------------------------------------------------------------
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
# Set to true to skip real pushes (logs the payload instead) - useful for testing
LINE_DRY_RUN=false

# ---------------------------------------------------------------------------
# Apple Store Thailand
#   APPLE_PRODUCT_URL     : buy-flow page used to discover part numbers
#   APPLE_MODEL_FILTER    : only variants whose name starts with this are tracked
#   APPLE_POSTAL_CODES    : seed postcodes used to discover stores (comma sep.)
#                           Apple returns every TH store for any valid postcode,
#                           so one seed is normally enough.
#   APPLE_MAX_PARTS_PER_REQUEST : iPhone Duo has 8 parts (4 sizes x 2 colours)
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Telegram (free, no monthly quota) - alternative/backup to LINE
# 1. Chat with @BotFather -> /newbot -> copy the token
# 2. Send any message to your new bot, then open:
#    https://api.telegram.org/bot<TOKEN>/getUpdates  and copy result[0].message.chat.id
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DRY_RUN=false

# ---------------------------------------------------------------------------
# Discord (free, no bot registration) - alternative/backup to LINE
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
# Comma-separate for several destinations.
# ---------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=
DISCORD_DRY_RUN=false

APPLE_BASE_URL=https://www.apple.com/th/
APPLE_PRODUCT_URL=https://www.apple.com/th/shop/buy-iphone/iphone-duo
APPLE_MODEL_FILTER=iPhone Duo
APPLE_POSTAL_CODES=10330
APPLE_MAX_PARTS_PER_REQUEST=16
# Catalog (part number) cache lifetime in minutes
APPLE_CATALOG_TTL_MINUTES=1440

# ---------------------------------------------------------------------------
# Scheduler
#   STOCK_CHECK_INTERVAL_SECONDS : fixed delay between the END of one run and
#                                  the START of the next (overlap-free by design)
#   STOCK_CHECK_CRON             : optional cron expression; when set it wins
#                                  over the interval (e.g. "*/30 * * * * *")
# ---------------------------------------------------------------------------
STOCK_CHECK_INTERVAL_SECONDS=30
STOCK_CHECK_CRON=
# Run one check immediately on boot instead of waiting for the first tick
RUN_ON_STARTUP=true

# ---------------------------------------------------------------------------
# HTTP behaviour against Apple
# ---------------------------------------------------------------------------
REQUEST_TIMEOUT_MS=10000
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=500
MAX_CONCURRENT_REQUESTS=3

# ---------------------------------------------------------------------------
# Adaptive cooldown (when Apple pushes back: 403 / 429 / 503 / 541)
#   After RATE_LIMIT_TRIGGER_FAILURES consecutive push-backs the bot stops
#   polling for BASE seconds, then doubles that on every further push-back up
#   to MAX. The first clean response resets it to the normal interval.
# ---------------------------------------------------------------------------
RATE_LIMIT_TRIGGER_FAILURES=2
RATE_LIMIT_COOLDOWN_BASE_SECONDS=120
RATE_LIMIT_COOLDOWN_MAX_SECONDS=1800
# Send a LINE message when the cooldown starts and when it recovers
RATE_LIMIT_ALERT_ENABLED=true
# Minimum gap between two system notices, so a flapping upstream cannot
# drain the message quota with cooldown/recovery chatter. 0 disables.
SYSTEM_ALERT_MIN_INTERVAL_MINUTES=30

# ---------------------------------------------------------------------------
# Distributed lock (only needed when running more than one bot instance)
# ---------------------------------------------------------------------------
DISTRIBUTED_LOCK_ENABLED=false
# Safety net: a lock older than this is considered stale and can be stolen
LOCK_TTL_SECONDS=300
