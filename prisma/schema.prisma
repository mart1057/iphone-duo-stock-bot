// iPhone Duo Stock Bot - Apple Store Thailand
// Availability source: GET https://www.apple.com/th/shop/retail/pickup-message

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Observed availability. UNKNOWN is used whenever Apple could not be reached
/// or returned a shape we do not understand. UNKNOWN is NEVER treated as
/// UNAVAILABLE - that would produce false "back in stock" alerts.
enum StockStatus {
  AVAILABLE
  UNAVAILABLE
  UNKNOWN
}

model Product {
  id        String           @id @default(uuid())
  model     String           @unique /// e.g. "iPhone 18 Pro Max"
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  variants  ProductVariant[]

  @@map("products")
}

model ProductVariant {
  id         String  @id @default(uuid())
  productId  String  @map("product_id")
  /// Apple part number, e.g. "MJXQ4ZP/A" - the true variant identifier
  partNumber String  @unique @map("part_number")
  /// Apple base part number, e.g. "MJXQ4"
  basePart   String? @map("base_part")
  color      String /// canonical English name, e.g. "Burgundy"
  colorTh    String? @map("color_th") /// Thai display name, e.g. "เบอร์กันดี"
  storage    String /// e.g. "256GB"
  priceTHB   Decimal? @map("price_thb") @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  stocks  Stock[]

  @@unique([productId, color, storage])
  @@index([productId])
  @@map("product_variants")
}

model Store {
  id        String   @id @default(uuid())
  /// Apple store number, e.g. "R733" (Central World), "R728" (Iconsiam)
  code      String   @unique
  name      String /// e.g. "Apple Central World"
  rawName   String?  @map("raw_name") /// exactly as Apple returns it
  city      String?
  province  String?
  address   String?
  country   String   @default("TH")
  latitude  Float?
  longitude Float?
  storeUrl  String?  @map("store_url")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks Stock[]

  @@map("stores")
}

model Stock {
  id        String @id @default(uuid())
  variantId String @map("variant_id")
  storeId   String @map("store_id")

  /// Last DEFINITIVE answer from Apple. Not touched by UNKNOWN checks,
  /// which is what makes the bot restart- and outage-safe.
  available Boolean @default(false)
  /// Last OBSERVED status, including UNKNOWN.
  status    StockStatus @default(UNKNOWN)

  lastCheckedAt   DateTime? @map("last_checked_at")
  lastAvailableAt DateTime? @map("last_available_at")
  /// Set on the very first observation so first-run never notifies.
  firstSeenAt     DateTime  @default(now()) @map("first_seen_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant           ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  store             Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  history           StockHistory[]
  notificationLogs  NotificationLog[]

  @@unique([variantId, storeId])
  @@index([available])
  @@index([storeId])
  @@map("stocks")
}

/// One row per OBSERVED CHANGE (not one row per check) to keep the table small.
model StockHistory {
  id        String      @id @default(uuid())
  stockId   String      @map("stock_id")
  available Boolean?
  status    StockStatus
  checkedAt DateTime    @default(now()) @map("checked_at")

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId, checkedAt])
  @@map("stock_history")
}

model NotificationLog {
  id             String      @id @default(uuid())
  stockId        String      @map("stock_id")
  previousStatus StockStatus @map("previous_status")
  currentStatus  StockStatus @map("current_status")
  sentAt         DateTime    @default(now()) @map("sent_at")
  messageId      String?     @map("message_id")
  success        Boolean     @default(true)
  error          String?

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId, sentAt])
  @@map("notification_logs")
}

/// Cooperative lock so multiple bot instances never run a check concurrently.
model JobLock {
  name       String   @id
  owner      String
  lockedAt   DateTime @default(now()) @map("locked_at")
  expiresAt  DateTime @map("expires_at")

  @@map("job_locks")
}

/// Per-Telegram-chat alert filter, managed from the bot's /alerts menu.
/// A row means "do NOT alert this chat for this value". An item is skipped
/// when ANY of its model / color / storage is muted. No rows = alert on all.
model TelegramAlertMute {
  id        String   @id @default(uuid())
  chatId    String   @map("chat_id")
  /// "model" | "color" | "storage"
  kind      String
  /// Canonical value: model name, English color ("Night Sky"), storage ("256GB")
  value     String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([chatId, kind, value])
  @@index([chatId])
  @@map("telegram_alert_mutes")
}

/// People who opened the Telegram invite link. Admin chats live in
/// TELEGRAM_CHAT_ID instead and are never stored here.
/// approved = false: waiting for an admin; gets nothing until approved.
model TelegramSubscriber {
  chatId     String    @id @map("chat_id")
  name       String?
  username   String?
  joinedAt   DateTime  @default(now()) @map("joined_at")
  approved   Boolean   @default(true)
  approvedAt DateTime? @map("approved_at")
  /// Last day of membership (Bangkok calendar date). On this day the member
  /// is removed and admins get a report. Null = never expires.
  expiresOn  DateTime? @map("expires_on") @db.Date

  @@map("telegram_subscribers")
}

/// Models an admin paused from Telegram (/models). Their part numbers are
/// left out of every availability request until resumed.
model PausedModel {
  model    String   @id
  pausedAt DateTime @default(now()) @map("paused_at")

  @@map("paused_models")
}

/// Bot-wide membership price, stored in satang to avoid floating point rounding.
model MembershipSettings {
  id         String   @id
  priceSatang Int     @map("price_satang")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("membership_settings")
}

/// One renewal reminder for each member and expiry date, with a retryable delivery lease.
model MembershipReminder {
  chatId     String    @map("chat_id")
  expiresOn  DateTime  @map("expires_on") @db.Date
  leaseUntil DateTime  @map("lease_until")
  sentAt     DateTime? @map("sent_at")

  @@id([chatId, expiresOn])
  @@map("membership_reminders")
}
